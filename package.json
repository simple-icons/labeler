    "semver": "^7.8.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.2",
    "@types/semver": "^7.7.1",
    "@vercel/ncc": "^0.38.4",
    "jest": "^30.4.2",
    "jest-circus": "^30.4.2",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3"
